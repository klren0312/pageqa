{
  "name": "pageqa",
  "version": "0.2.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klren0312/pageqa.git"
  },
  "description": "用自然语言驱动的页面 QA agent：pi-agent-core 编排测试步骤，browserskill(bsk) 驱动真实浏览器执行，LLM 端点可配置（OpenAI 兼容）；输出文本/JSON 报告与可直接接入 CI 的退出码。",
  "type": "module",
  "bin": {
    "pageqa": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test tests/smoke.test.mjs",
    "test:unit": "npm run build && node --test tests/report.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "keywords": [
    "page-qa",
    "e2e",
    "testing",
    "agent",
    "pi-agent-core",
    "browserskill",
    "bsk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
